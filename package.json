{
  "name": "fama-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Repositório unificado do Fama System, Fama Control e banco compartilhado.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "install:apps": "node scripts/apps.mjs install",
    "dev:system": "npm --prefix apps/fama-system run dev -- --host 127.0.0.1 --port 5173",
    "dev:control": "npm --prefix apps/fama-control run dev -- --host 127.0.0.1 --port 5174",
    "build": "node scripts/apps.mjs build",
    "typecheck": "node scripts/apps.mjs typecheck",
    "lint": "node scripts/apps.mjs lint",
    "test": "node scripts/apps.mjs test",
    "test:control:localhost": "npm --prefix apps/fama-control run test:localhost",
    "verify": "node scripts/verify-repository.mjs",
    "verify:source": "node scripts/verify-repository.mjs --strict-source",
    "package": "python3 scripts/export-repository.py"
  }
}
