{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node features/qa/server.mjs",
    "build:pedidos": "node features/pedidos/build.mjs",
    "test:pedidos": "node --test features/pedidos/*.test.mjs",
    "dev:pedidos": "node features/pedidos/preview.mjs",
    "test:glass": "node --test features/liquid-glass/*.test.mjs",
    "test": "node --test features/pedidos/*.test.mjs features/liquid-glass/*.test.mjs",
    "check:companion": "node apps/system/scripts/verify-companion.mjs apps/control",
    "check:syntax": "node scripts/audit-syntax.mjs",
    "build": "node features/pedidos/build.mjs && node scripts/audit-build.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='features/pedidos/*.mjs' --test-coverage-exclude='**/*.test.mjs' --test-coverage-exclude='**/test-support.mjs' --test-coverage-exclude='**/build.mjs' --test-coverage-exclude='**/preview.mjs' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test features/pedidos/*.test.mjs",
    "lint": "eslint features/pedidos features/liquid-glass scripts/audit-*.mjs",
    "check:types": "tsc -p jsconfig.audit.json",
    "check:secrets": "node scripts/audit-secrets.mjs",
    "security:dependencies": "node scripts/audit-dependencies.mjs",
    "test:e2e": "playwright test"
  },
  "name": "fama-platform",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "linkedom": "0.18.15",
    "typescript": "5.9.3"
  }
}
