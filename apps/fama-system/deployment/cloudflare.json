{
  "name": "fama-system-app",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "fama-system-app-data", "database_id": "107fb3a8-87f4-4d50-aa18-424ef5a0e271"}],
  "services": [
    {"binding": "FAMA_CONTROL", "service": "fama-control-app"},
    {"binding": "FAMA_PYTHON_SERVICE", "service": "fama-ai-python"}
  ],
  "routes": [
    {"pattern": "famasystem.online", "custom_domain": true},
    {"pattern": "www.famasystem.online", "custom_domain": true}
  ],
  "observability": {"enabled": true, "head_sampling_rate": 1, "redact_query_string": true}
}
