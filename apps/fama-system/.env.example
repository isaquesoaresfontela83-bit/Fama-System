PLATFORM_OWNER_EMAIL=administrador@exemplo.com
PLATFORM_OWNER_USER_ID=supabase-user-id-do-proprietario

# Use "d1" durante a preparação e "supabase" somente depois da migração dos dados.
DATA_BACKEND=d1
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_substitua_no_ambiente_seguro
SUPABASE_STORAGE_BUCKET=fama-documents
# Base64/hex de 32 bytes. Nunca coloque no navegador ou no repositório.
FAMA_DATA_ENCRYPTION_KEY=gere-uma-chave-de-32-bytes-no-servidor

# Checkout público da plataforma. Configure estes valores apenas como segredos
# do ambiente publicado para gerar Pix real antes do cadastro da empresa.
FAMA_ASAAS_ENVIRONMENT=production
FAMA_ASAAS_API_KEY=$aact_prod_substitua_no_ambiente_seguro
FAMA_ASAAS_WEBHOOK_TOKEN=gere-um-token-longo-para-validar-webhook

# No financeiro interno, cada empresa conecta sua própria chave Asaas pela
# interface. Ela é validada, criptografada e nunca é exibida novamente.

# Segredo privado compartilhado entre os servidores System e Control.
FAMA_DATA_BRIDGE_SECRET=gere-um-segredo-aleatorio-no-ambiente-seguro

# Conversa generativa opcional: desativada por padrão.
# Configure a chave somente como segredo do servidor após autorizar o provedor.
FAMA_AI_GENERATIVE_ENABLED=false
FAMA_AI_MODEL=gpt-5-mini
OPENAI_API_KEY=substitua_no_ambiente_seguro
