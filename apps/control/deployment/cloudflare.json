{
  "name": "fama-control-app",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fama-control-app-data",
      "database_id": "966f522c-d2e3-4d68-a495-13604711bbac"
    },
    {
      "binding": "FAMA_STATIC_ASSETS",
      "database_id": "a02259e9-97ff-4cba-8deb-568b7e584067"
    }
  ],
  "services": [
    {
      "binding": "BAILEYS_SERVICE",
      "service": "fama-baileys"
    },
    {
      "binding": "FAMA_SYSTEM",
      "service": "fama-system-app"
    },
    {
      "binding": "FAMA_PYTHON_SERVICE",
      "service": "fama-ai-python"
    }
  ],
  "routes": [
    {
      "pattern": "control.famasystem.online",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  }
}
