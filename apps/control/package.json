{
  "name": "fama-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "build:cloudflare": "FAMA_DEPLOY_TARGET=cloudflare npm run build && node ../../deployment/cloudflare/prepare-release.mjs control",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node scripts/run-test-suite.mjs",
    "test:localhost": "node --import ./tests/localhost-only.mjs --experimental-loader ./tests/cloudflare-loader.mjs --test --test-name-pattern localhost tests/launch-readiness.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "check:js": "node scripts/check-javascript.mjs",
    "build:vps": "node scripts/prepare-vps-assets.mjs && FAMA_DEPLOY_TARGET=vps NEXT_PUBLIC_FAMA_RUNTIME=vps next build --webpack && node scripts/pack-vps-standalone.mjs",
    "test:vps": "node --test deployment/vps/runtime.test.mjs",
    "start:vps": "FAMA_RUNTIME=vps node .next/standalone/server.js",
    "build:hybrid-static": "node scripts/prepare-vps-assets.mjs && vite build --config deployment/hybrid/vite.config.mjs",
    "build:hybrid-api": "node scripts/prepare-vps-assets.mjs && FAMA_DEPLOY_TARGET=hybrid NEXT_PUBLIC_FAMA_RUNTIME=hybrid next build --webpack && node scripts/pack-vps-standalone.mjs",
    "start:hybrid-api": "FAMA_RUNTIME=hybrid node server/hybrid-check.mjs && FAMA_RUNTIME=hybrid node .next/standalone/server.js",
    "test:hybrid": "node --test deployment/hybrid/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@huggingface/transformers": "4.3.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "react-test-renderer": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "dompurify": "3.4.16"
  }
}
