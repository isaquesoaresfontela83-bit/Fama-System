# Configurar SOMENTE no serviço de API. Nunca usar prefixo VITE_ ou NEXT_PUBLIC_.
FAMA_RUNTIME=hybrid
DATA_BACKEND=supabase
FAMA_PUBLIC_URL=https://famasystem.online
FAMA_POSTGRES_URL=
FAMA_POSTGRES_SCHEMA=fama_system_runtime
# CA oficial do projeto, caso a conexão a exija. A verificação TLS permanece ativa.
FAMA_POSTGRES_CA=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_ENABLED=true
# Manter a chave original de criptografia para ler os dados importados.
FAMA_DATA_ENCRYPTION_KEY=
FAMA_SESSION_SECRET=
FAMA_DATA_BRIDGE_SECRET=
FAMA_INTERNAL_CONTROL_URL=
FAMA_CONTROL_PUBLIC_URL=https://control.famasystem.online
FAMA_AI_PROVIDER=local-python
FAMA_AI_GENERATIVE_ENABLED=false
# Não configurar disco local para backups ou Baileys neste destino.
