PLATFORM_OWNER_EMAIL=administrador@exemplo.com
PLATFORM_OWNER_USER_ID=supabase-user-id-do-proprietario

# Use "d1" durante a preparação e "supabase" somente depois da migração dos dados.
DATA_BACKEND=d1
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_substitua_no_ambiente_seguro
SUPABASE_STORAGE_BUCKET=fama-documents
# Base64/hex de 32 bytes. Nunca coloque no navegador ou no repositório.
FAMA_DATA_ENCRYPTION_KEY=gere-uma-chave-de-32-bytes-no-servidor

# Checkout público da plataforma. Configure estes valores apenas como segredos
# do ambiente publicado para gerar Pix real antes do cadastro da empresa.
FAMA_ASAAS_ENVIRONMENT=production
FAMA_ASAAS_API_KEY=$aact_prod_substitua_no_ambiente_seguro
FAMA_ASAAS_WEBHOOK_TOKEN=gere-um-token-longo-para-validar-webhook

# No financeiro interno, cada empresa conecta sua própria chave Asaas pela
# interface. Ela é validada, criptografada e nunca é exibida novamente.

# Serviço próprio de rotas OSRM por HTTPS para estimar o frete pela rota viária.
# Sem esta configuração, a Consulta permite informar os km manualmente.
# Origem e tarifa por km são definidas em Configurações da empresa > Frete.
FAMA_ROUTING_BASE_URL=

# Segredo privado compartilhado entre os servidores System e Control.
FAMA_DATA_BRIDGE_SECRET=gere-um-segredo-aleatorio-no-ambiente-seguro


# Chave opcional compartilhada da API CPF. Preferir chave por empresa.

# Cloudflare Workers AI: token apenas como segredo do servidor.
FAMA_AI_PROVIDER=cloudflare
FAMA_AI_GENERATIVE_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
FAMA_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
FAMA_AI_MAX_TOKENS=1024
FAMA_AI_TIMEOUT_MS=20000
# Compatibilidade temporária: o token anteriormente cadastrado em ANTHROPIC_API_KEY
# também é lido como token Cloudflare, sem envio à Anthropic.
# Diagnóstico desativado por padrão. Ative temporariamente junto com um segredo
# aleatório de 32 bytes e desative antes da publicação final.
FAMA_AI_CONNECTION_TEST_ENABLED=false
# FAMA_AI_CONNECTION_TEST_SECRET: segredo temporário de diagnóstico, removido após os testes.

# Central server-only OpenRouteService/HeiGIT Standard plan key (optional).
FAMA_OPENROUTESERVICE_API_KEY=

# Google Cloud OAuth Web client: enable Calendar API and authorize both Fama origins.
# Public client identifier, not a client secret. Each user consents to their own calendar.
FAMA_GOOGLE_CALENDAR_CLIENT_ID=

# Serviço Python da Fama IA (somente servidor)
FAMA_AI_PYTHON_URL=https://fama-ai-python.famasystem.workers.dev
FAMA_AI_PYTHON_TOKEN=
FAMA_AI_GENERATIVE_ENABLED=false
