# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Generated application output and test artifacts
/.next/
/.vinext/
/out/
/dist/
/coverage/
/tests/artifacts/
*.tsbuildinfo
next-env.d.ts

# build/ contains source imported by vite.config.ts. Keep it tracked.
# vendor/ contains CSS and third-party notices used by the application.
# sites-release/ contains historical release material, not generated output.

# Environment files: retain only the example
.env*
!.env.example
.dev.vars
.dev.vars.*
*.pem
*.key

# Local tools and deployment state
.vercel/
.wrangler/
.sites-runtime/
.agents/
.codex/
/outputs/
/work/

# Logs and editor/OS files
*.log
.DS_Store
Thumbs.db
*.swp
