# Fama System — example environment configuration
# Copy to your local environment and replace placeholders with real values.
# Never commit production passwords, tokens, API keys or secrets.

# Platform administration
PLATFORM_OWNER_EMAIL=admin@example.com

# Required to sign the Fama authentication cookie/session.
# Production value must be random and at least 32 characters long.
FAMA_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Supabase Auth
# Authentication currently uses Supabase Auth. Keep project-specific values in
# the deployment environment instead of hard-coding them in application code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional Cloudflare local overrides.
# Production bindings are defined by the hosting/deployment environment.
CLOUDFLARE_WORKER_NAME=server
CLOUDFLARE_D1_DATABASE_NAME=site-creator-d1
CLOUDFLARE_D1_DATABASE_ID=00000000-0000-4000-8000-000000000000
