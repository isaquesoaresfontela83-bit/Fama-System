# Fama System — configuração de referência, sem credenciais reais.
# Configure os valores no ambiente de execução. Não use este arquivo em produção.

# Administração da plataforma
PLATFORM_OWNER_EMAIL=admin@example.com

# Segredo de assinatura de sessão: aleatório, com pelo menos 32 caracteres.
# Deixe vazio neste exemplo; gere um segredo próprio fora do Git.
FAMA_SESSION_SECRET=

# Econodata API V4 — chave privada, somente no servidor.
# Gere a chave em Integrações & API na Econodata e cadastre-a como secret no ambiente.
# Nunca prefixe esta variável com NEXT_PUBLIC_ ou VITE_.
ECONODATA_API_KEY=
ECONODATA_BASE_URL=https://api.econodata.com.br

# Overrides opcionais do Vite/Cloudflare para desenvolvimento.
CLOUDFLARE_WORKER_NAME=server
CLOUDFLARE_D1_DATABASE_NAME=site-creator-d1
CLOUDFLARE_D1_DATABASE_ID=00000000-0000-4000-8000-000000000000

# A main ainda define a URL e a chave publicável do Supabase no login.
# SUPABASE_URL e SUPABASE_PUBLISHABLE_KEY só passarão a configurar esse
# endpoint quando a alteração de autenticação em revisão for integrada.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=

# As Edge Functions em supabase/functions/ têm ambiente próprio no Supabase.
# Chaves privadas e service-role pertencem exclusivamente ao servidor.
