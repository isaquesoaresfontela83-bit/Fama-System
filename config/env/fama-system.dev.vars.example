# Copie para .dev.vars dentro do projeto e preencha com os valores do NOVO ambiente.
# Não use source neste arquivo. Não versione nem publique seus valores.
DATA_BACKEND="supabase"
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_AUTH_ENABLED="true"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="fama-documents"
PLATFORM_OWNER_EMAIL=""
PLATFORM_OWNER_USER_ID=""
FAMA_DATA_ENCRYPTION_KEY=""
FAMA_DATA_BRIDGE_SECRET=""

# Assinaturas da plataforma: configure primeiro com credenciais sandbox próprias.
FAMA_ASAAS_ENVIRONMENT="sandbox"
FAMA_ASAAS_API_KEY=""
FAMA_ASAAS_WEBHOOK_TOKEN=""

# Opcionais. Consulte documentacao/CONFIGURACAO.md.
OPENAI_API_KEY=""
FAMA_AI_MODEL=""
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_VERIFY_TOKEN=""
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
FAMA_SESSION_SECRET=""

# Manutenção temporária de lançamento: manter vazios em uso normal.
FAMA_LAUNCH_CHECK_TOKEN=""
FAMA_LAUNCH_CHECK_EXPIRES_AT=""
